<?xml version="1.0"?>
<package format="3">
  <name>autodrive_forzaeth</name>
  <version>0.1.0</version>
  <description>Runs the ForzaETH race stack against the AutoDRIVE simulator: adapter, mapper, run logger, raceline swap tools.</description>
  <maintainer email="emcphilliamy@gmail.com">emcphilliamy</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>f110_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
